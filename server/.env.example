# EXEMPLE de /etc/mdtprox.env  (droits 0600, propriétaire root).
# Toutes les valeurs ci-dessous sont FACTICES : remplacez-les, sans jamais committer le vrai fichier.
# Mettez les valeurs entre guillemets doubles ; dans un mot de passe, écrivez \" pour un guillemet
# et \\ pour une barre oblique inverse.

# URL que les PC utilisent pour joindre l'API (sans "/" final)
PUBLIC_BASE_URL="http://10.0.0.3:8080"
# Écoute de l'API (lues par la ligne de commande uvicorn : --host $BIND_HOST --port $BIND_PORT)
BIND_HOST="0.0.0.0"
BIND_PORT="8080"
# Dossier des profils, images, mini-système et du journal (audit.jsonl)
DATA_DIR="/srv/deploy"

# Domaine Active Directory à rejoindre, et compte autorisé à y créer des ordinateurs
DOMAIN_FQDN="example.local"
DOMAIN_JOIN_USER="svc-joindomaine"
DOMAIN_JOIN_PASSWORD="CHANGEZ-MOI"

# Compte administrateur local créé sur TOUS les PC
LOCAL_ADMIN_USER="admin-local"
LOCAL_ADMIN_PASSWORD="CHANGEZ-MOI"

# Fuseau horaire Windows et langue/clavier (valeurs par défaut)
WIN_TIMEZONE="Romance Standard Time"
WIN_LOCALE="fr-FR"

# Anti-devinette de code : essais ratés avant blocage (défaut 3), durée du blocage en secondes (défaut 300)
MAX_BAD_CODES="3"
LOCKOUT_SECONDS="300"

# --- Pages d'administration (/admin/images : codes des images)
# Laissez vides pour DÉSACTIVER ces pages. À terme, les identifiants seront vérifiés auprès de l'Active Directory.
ADMIN_USER=""
ADMIN_PASSWORD=""
# 1 = banc d'essai ISOLÉ seulement : autorise des identifiants de démonstration comme admin / pikachu.
# (Pourquoi pikachu ? J'avais une Nintendo DS avec Pikachu devant moi au moment de la rédaction.)
# En exploitation : laisser vide, et choisir un mot de passe d'au moins 10 caractères, sinon les pages refusent de s'ouvrir.
LAB_MODE=""
